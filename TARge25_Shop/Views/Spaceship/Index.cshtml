@model IEnumerable<TARge25_Shop.Models.Spaceship.SpaceshipIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary" id="CreateInIndex">Create</a>
</div>
<div class="h1">
    Spaceships
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th id="IndexRowNumberColumn" scope="col">Nr</th>
                <th id="IndexNameColumn" scope="col">Name</th>
                <th id="IndexTypeColumn" scope="col">Type</th>
                <th id="IndexBuiltDateColumn" scope="col">Built Date</th>
                <th id="IndexCrewColumn" scope="col">Crew</th>
                <th id="IndexActionColumn" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td id="IndexRowNumberSpaceship">@(rowNumber++)</td>
                    <td id="IndexNameSpaceship">@spaceship.Name</td>
                    <td id="IndexTypeeSpaceship">@spaceship.ShipType</td>
                    <td id="IndexBuiltDateSpaceship">@spaceship.CreatedAt</td>
                    <td id="IndexCrewSpaceship">@spaceship.Crew</td>
                    <td id="IndexActionSpaceship">
                        <div class="action-buttons">
                            <a asp-action="details" asp-route-id="@spaceship.Id" class="btn btn-outline-primary" id="IndexSpaceshipDetails">Details</a>
                            <a asp-action="update" asp-route-id="@spaceship.Id" class="btn btn-outline-primary" id="IndexSpaceshipUpdate">Update</a>
                            <a asp-action="delete" asp-route-id="@spaceship.Id" class="btn btn-outline-danger" id="IndexSpaceshipDelete">Delete</a>
                        </div>
                    </td>
                </tr>
                @* rowNumber += 1; See ei ole vaja kuna üleval tegime ++ *@
            }
        </tbody>
    </table>
</form>
