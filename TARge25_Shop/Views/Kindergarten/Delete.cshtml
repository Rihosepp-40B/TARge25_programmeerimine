@model TARge25_Shop.Models.Kindergarten.KindergartenDeleteViewModel

    <h1>
        Kindergarten Delete
    </h1>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_Id" class="form-control-plaintext">@Model.Id</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="GroupName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_GN" class="form-control-plaintext">@Model.GroupName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ChildrenCount" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_CC" class="form-control-plaintext">@Model.ChildrenCount</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="KindergartenName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_KN" class="form-control-plaintext">@Model.KindergartenName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="TeacherName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_TN" class="form-control-plaintext">@Model.TeacherName</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_CA" class="form-control-plaintext">@Model.CreatedAt</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="UpdatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p id="Del_Kg_UA" class="form-control-plaintext">@Model.UpdatedAt</p>
        </div>
    </div>

    <input asp-action="DeleteConfirmation" asp-controller="kindergarten" type="submit" id="Del_Kg_Del" class="btn btn-primary" value="Delete Confirmation" />
    <a asp-action="Index" asp-controller="kindergarten" id="Del_Kg_Back" class="btn btn-secondary">Back to List</a>

</form>