@model TARge25_Shop.Models.Spaceship.SpaceshipDetailViewModel

<h1>
    Spaceship Details
</h1>
<form method="post" enctype="multipart/form-data">

    <div class="form-group row">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Id" id="Details_SS_Id" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" id="Details_SS_Name" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" id="Details_SS_Type" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" id="Details_SS_Crew" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" id="Details_SS_EP" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="CreatedAt" id="Details_SS_CA" class="form-control-plaintext" disabled />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="UpdatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UpdatedAt" id="Details_SS_UA" class="form-control-plaintext" disabled />
        </div>
    </div>

    @foreach (var images in Model.Image)
    {
        <partial name="_Images" model="images" />
    }

    <a asp-action="Index" asp-controller="spaceship" id="Details_SS_Back" class="btn btn-secondary">Back to List</a>

</form>