@model TARge25_Shop.Models.OpenWeather.OpenWeatherSearchViewModel

<div class="container card col-md-5 text-bg-dark shadow-lg">
    <h2>Current weather ...</h2>

    @* Funktsiooni nimi lähen asp-action'isse *@
    <form asp-action="SearchCity" method="post">
        <div class="container">
            <div class="form-group col-md-10 mt-6">
                <input asp-for="City" class="form-control" placeholder="Type a City name to see weather there" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
        <div class="container">
            <div class="form-group col-md-5">
                <button type="submit" class="btn btn-primary mt-2">Search city</button>
            </div>
        </div>
    </form>
</div>
