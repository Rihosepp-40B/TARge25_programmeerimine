
<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TARge25_Shop</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TARge25_Shop.styles.css"
          asp-append-version="true" />
</head>

<body class="cave-theme">

    <!-- Taustal hõljuvad sädemed -->
    <div id="ember-layer" aria-hidden="true"></div>

    <header class="cave-header">
        <nav class="navbar navbar-expand-xl cave-navbar">
            <div class="container-fluid">

                <a class="navbar-brand fiery-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    TARge25_Shop
                </a>

                <button class="navbar-toggler cave-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Ava menüü">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-xl-center">

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="Home"
                               asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="Spaceship"
                               asp-action="Index">Spaceship</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="RealEstate"
                               asp-action="Index">Real Estate</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="Kindergarten"
                               asp-action="Index">Kindergarten</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="ChuckNorris"
                               asp-action="Index">Chuck Norris</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="Cocktail"
                               asp-action="Index">Cocktails</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fiery-link"
                               asp-controller="OpenWeather"
                               asp-action="Index">Weather</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid cave-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="cave-footer">
        <div class="container">
            &copy; 2026 - TARge25_Shop -
            <a asp-controller="Home"
               asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="~/js/cave-effects.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
