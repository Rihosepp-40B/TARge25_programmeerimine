@model TARge25_Shop.Models.Account.ResetPasswordViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title mb-2">Reset password</h3>
                    <hr />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form asp-action="ResetPassword" method="post">

                        <input asp-for="Email" type="hidden" />

                        <input asp-for="Token" type="hidden" />

                        <div class="form-group">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmationPassword" class="form-label"></label>
                            <input asp-for="ConfirmationPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmationPassword" class="text-danger small"></span>
                        </div>
                        <br />
                        <button type="submit" class="btn btn-primary">
                            Reset password
                        </button>
                        <div class="text-center mt-3">
                            <a asp-action="Login" class="text-decoration-none">
                                Back to login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

