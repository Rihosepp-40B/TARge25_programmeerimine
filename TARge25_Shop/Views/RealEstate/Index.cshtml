@model IEnumerable<TARge25_Shop.Models.RealEstate.RealEstateIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="realestate" type="submit" class="btn btn-primary">Create</a>
</div>
<div class="h1">
    Real Estates
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Area</th>
                <th scope="col">Location</th>
                <th scope="col">RoomNumber</th>
                <th scope="col">BuildingType</th>
                <th scope="col">CreatedAt</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var realEstate in Model)
            {
                <tr>
                    <td>@(rowNumber++)</td>
                    <td>@realEstate.Area</td>
                    <td>@realEstate.Location</td>
                    <td>@realEstate.RoomNumber</td>
                    <td>@realEstate.BuildingType</td>
                    <td>@realEstate.CreatedAt</td>
                    <td>
                        <div class="action-buttons">
                            <a asp-action="details" asp-route-id="@realEstate.Id" class="btn btn-outline-primary">Details</a>
                            <a asp-action="update" asp-route-id="@realEstate.Id" class="btn btn-outline-primary">Update</a>
                            <a asp-action="delete" asp-route-id="@realEstate.Id" class="btn btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
                @* rowNumber += 1; See ei ole vaja kuna üleval tegime ++ *@
            }
        </tbody>
    </table>
</form>