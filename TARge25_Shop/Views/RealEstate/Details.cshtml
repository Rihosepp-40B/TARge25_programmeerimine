@model TARge25_Shop.Models.RealEstate.RealEstateDetailViewModel

    <h1>
        Real Estate Details
    </h1>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="form-group row">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.Id</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Area" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.Area</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.Location</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.RoomNumber</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.BuildingType</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.CreatedAt</p>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ModifiedAt" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <p class="form-control-plaintext">@Model.ModifiedAt</p>
        </div>
    </div>
    <dl>
        @foreach (var images in Model.Image)
        {
            <partial name="_Images" model="images" />
        }
    </dl>
    <hr/>
    <a asp-action="Index" asp-controller="realEstate" class="btn btn-secondary">Back to List</a>

</form>